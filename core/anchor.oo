// # oobanner Core Subsystem Anchor
//
// Logline: Consolidates multi-line font glyphs, layout framing, and banner compositing engine.
//
// Setup: Root barrel shim for core FIGLET and ASCII typography domain.
//
// Beats:
//   1. Re-export standard 5-line and compact 3-line font glyph renderers.
//   2. Re-export box framing, alignment coordinates, and padding routines.
//   3. Re-export text compositing engine for banner generation.

import "core/font_std_symbols.oo";
import "core/font_block.oo";
import "core/banner_box.oo";
import "core/banner_engine.oo";

pub fn core_subsystem_version() -> String {
    return "0.2.0";
}
