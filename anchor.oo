// # oobanner Root Anchor Subsystem
//
// Logline: Top-level anchor re-exporting typography fonts, banner layout engine, and MCP stdio IPC.
//
// Setup: Root barrel shim linking all oobanner subsystem anchors into a coherent suite.
//
// Beats:
//   1. Re-export core multi-line font glyphs, layout framing, and banner compositing engine.
//   2. Re-export render formatting subsystem with ANSI styles and JSON visualizers.
//   3. Re-export Model Context Protocol (MCP) IPC subsystem and CLI argument parsers.
//   4. Expose unified system metadata and version verification constants.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn oobanner_version() -> String {
    return "0.2.0";
}

pub fn oobanner_summary() -> String {
    return "Sovereign FIGLET & Stylized ASCII Typography Banner Engine";
}
